# Optional. If unset, the admin page uses the current window origin.
# Set this on Vercel to the final public URL so printed QR cards always point
# to the live site (e.g. https://banalata-order.vercel.app).
NEXT_PUBLIC_BASE_URL=

# Optional Basic Auth to lock /kitchen and /admin (leave blank to keep them open).
STAFF_USER=
STAFF_PASS=
